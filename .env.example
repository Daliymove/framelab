# Copy this file to .env. FrameLab loads it automatically on startup.
# Required for image generation
CODEX_IMAGE_API_KEY=replace-me
CODEX_IMAGE_BASE_URL=https://example.com/v1
CODEX_IMAGE_PROVIDER_ID=codex-relay
CODEX_IMAGE_PROVIDER_NAME=Image Relay

# Optional CloudFlare-ImgBed REST integration
FRAMELAB_IMGBED_BASE_URL=http://127.0.0.1:8080
FRAMELAB_IMGBED_API_TOKEN=imgbed_replace-me
FRAMELAB_IMGBED_UPLOAD_PATH=/upload
FRAMELAB_IMGBED_UPLOAD_CHANNEL=discord
FRAMELAB_IMGBED_UPLOAD_CHANNEL_NAME=discard-image
# FRAMELAB_IMGBED_UPLOAD_FOLDER=framelab

# Runtime data lives outside the repository by default
# FRAMELAB_DATA_DIR=C:\Users\your-name\Pictures\FrameLab
